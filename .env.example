# Copy to .env and adjust; all of it is optional, but without
# OPENROUTER_API_KEY every user must give their own key in the page's
# settings.

# --- The models reading CVs and describing candidates ---
# The key everyone's requests go with unless they give their own in the
# page's settings (https://openrouter.ai/keys; set a spending limit there).
#OPENROUTER_API_KEY=
# The last model on everyone's list, which users can't remove:
# openrouter/free picks some free model per request.
OPENROUTER_MODEL=openrouter/free
# Free models, comma-separated, tried in this order, one attempt each (a
# model that's down or rate-limited fails in a second); then
# OPENROUTER_MODEL. Free models come and go, and some turn paid: check the
# list and its prices at https://openrouter.ai/models. Their providers may
# keep what they're sent – here, the users' CVs.
OPENROUTER_MODELS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free
# Paid models, tried before all of those for users who want them (the
# switches in the settings). "~..." is OpenRouter's alias for the latest
# model of a family. Reading a CV with Claude Haiku costs about a tenth of
# a cent.
OPENROUTER_PAID_MODELS=~anthropic/claude-haiku-latest
# Whether users who haven't chosen yet get the paid models...
OPENROUTER_PAID_DEFAULT=1
# ...and the free ones (OPENROUTER_MODELS and OPENROUTER_MODEL). Free
# models' providers may keep what they're sent, the users' CVs: with them
# off, nothing goes to a free model, even when every paid one fails.
OPENROUTER_FREE_DEFAULT=0
# The settings warn when fewer dollars than this are left on the key.
OPENROUTER_LOW_FUNDS=0.5
# Attempts with OPENROUTER_MODEL before a request is given up.
OPENROUTER_ATTEMPTS=3
# Seconds one request may take.
OPENROUTER_TIMEOUT=180
# Sampling temperature (empty: the model's default).
#OPENROUTER_TEMPERATURE=0.3
# Any OpenAI-compatible chat completions endpoint.
#OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions

# --- Web page ---
WEB_HOST=0.0.0.0
WEB_PORT=8075
# 0: no accounts made from the page (`app.py --add-user USER` still can).
ALLOW_REGISTRATION=1

# Database and uploaded CVs (default: ./data).
#DATA_DIR=/srv/cv-aggregator

# --- CVs ---
# CVs a user may keep.
MAX_CVS=6
# Largest file accepted, in megabytes.
MAX_CV_MB=5
# A CV's text is cut to this many characters before a model reads it.
MAX_CV_CHARS=40000
# Threads reading CVs and writing analyses (one user's CVs are read one
# after another).
WORKERS=2

# Minimum log level (DEBUG, INFO, WARNING, ...).
LOG_LEVEL=INFO
